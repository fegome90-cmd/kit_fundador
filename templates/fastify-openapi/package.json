{
  "name": "kit-fastify-openapi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=24 <25"},
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "start": "node dist/server.js",
    "dev": "pnpm run build && node --watch dist/server.js"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
