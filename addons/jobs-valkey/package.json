{
  "name": "@kit-fundador/jobs-valkey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Opt-in BullMQ/Valkey producer and standalone worker (experimental)",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "test:ci": "pnpm run typecheck && pnpm test",
    "worker": "node dist/worker-entry.js"
  },
  "dependencies": {
    "bullmq": "6.3.15",
    "ioredis": "6.0.0"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fastify": "5.12.7",
    "typescript": "5.9.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ]
}
